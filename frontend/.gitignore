# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.vite
/test-results/
/playwright-report/
/playwright-report-integration/

# next.js
/.next/
# Playwright WebSocket-chat dev server (playwright.config.ts)
/.next-e2e-ws/
# Separate dist dir for e2e runs while a local `next dev` holds /.next
/.next-e2e-main/
# Playwright route-gate dev server (RUDIX_ROUTE_GATE=enforce, R07-09)
/.next-e2e-gate/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# licensed fonts (Pelak, Fontiran) are provided per environment, not committed
/public/fonts/pelak/*
!/public/fonts/pelak/.gitkeep
