# Prometheus & Grafana Observability Configuration
# Copy this file to .env in infra/observability/ if running standalone.

PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB

ALERTMANAGER_PORT=9093

GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
# WARNING: Change password before non-local deployment — never commit real secrets
GRAFANA_ADMIN_PASSWORD=change-me-in-production

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_app
